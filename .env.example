# Smart Control Tower - Environment Variables Template
# Add at least ONE of the following API keys in your Vercel Project Settings:

# Primary Provider (Groq is fast and has high free rate limits)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Alternative / Fallback Providers
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Optional Server Settings (handled automatically on Vercel)
SMART_TOWER_PORT=4173
